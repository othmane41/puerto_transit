<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ RÉGIME ══════════════════════════════════════════════════════════ -->
    <record id="view_puerto_regime_form" model="ir.ui.view">
        <field name="name">puerto.regime.form</field>
        <field name="model">puerto.regime</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_puerto_regime_tree" model="ir.ui.view">
        <field name="name">puerto.regime.tree</field>
        <field name="model">puerto.regime</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>
    <record id="action_puerto_regime" model="ir.actions.act_window">
        <field name="name">Régimes Douaniers</field>
        <field name="res_model">puerto.regime</field>
        <field name="view_mode">list,form</field>
    </record>

