<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_puerto_dossier_facture_form" model="ir.ui.view">
        <field name="name">puerto.dossier.facture.form</field>
        <field name="model">puerto.dossier.facture</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="num_facture"/>
                            <field name="date_facture"/>
                            <field name="partner_id"/>
                            <field name="dossier_id"/>
                        </group>
                        <group>
                            <field name="poids_brut_total"/>
                            <field name="poids_net_total"/>
                            <field name="currency_id"/>
                            <field name="valeur_total"/>
                        </group>
                        <group>
                            <field name="paiement"/>
                            <field name="type_marchandise"/>
                            <field name="incoterm_id"/>
                            <field name="notion_origine"/>
                            <field name="num_eacce"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes de Facture">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="code_article"/>
                                    <field name="description"/>
                                    <field name="code_nomenclature"/>
                                    <field name="designation_commerciale"/>
                                    <field name="uom_id"/>
                                    <field name="quantite"/>
                                    <field name="poids_net_unitaire"/>
                                    <field name="prix_unitaire"/>
                                    <field name="prix_net"/>
                                    <field name="montant_devise"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_puerto_dossier_facture_tree" model="ir.ui.view">
        <field name="name">puerto.dossier.facture.tree</field>
        <field name="model">puerto.dossier.facture</field>
        <field name="arch" type="xml">
            <list>
                <field name="num_facture"/>
                <field name="date_facture"/>
                <field name="dossier_id"/>
                <field name="partner_id"/>
                <field name="valeur_total"/>
                <field name="currency_id"/>
                <field name="paiement"/>
            </list>
        </field>
    </record>

    <record id="action_puerto_dossier_facture" model="ir.actions.act_window">
        <field name="name">Factures Transit</field>
        <field name="res_model">puerto.dossier.facture</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
